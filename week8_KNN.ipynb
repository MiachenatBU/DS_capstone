import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import classification_report, confusion_matrix, accuracy_score

# ==========================================
# 1. LOAD DATA
# ==========================================
# Replace 'h244.csv' with the actual path to your MEPS CSV file
# Note: The documentation provided was a PDF, so you will need the actual data file (e.g., .csv or .sas7bdat)
df = pd.read_csv('h244.csv')

# ==========================================
# 2. DATA CLEANING & PREPROCESSING
# ==========================================

# Select relevant variables based on the HC-244 Codebook
# Target: RTHLTH4 (Perceived Health Status, Round 4)
# Features: AGE4X (Age), ADBMI4 (BMI), K6SUM4 (Mental Health Score)
columns_of_interest = ['RTHLTH4', 'AGE4X', 'ADBMI4', 'K6SUM4']
data = df[columns_of_interest].copy()

# Filter out invalid responses (Negative values often indicate skipped/inapplicable/DK/Refused in MEPS)
# RTHLTH4: 1-5 are valid
# AGE4X: >= 0 valid
# ADBMI4: > 0 valid (Codebook notes -1 Inapplicable, -15 Cannot be computed)
# K6SUM4: 0-24 valid
data = data[
    (data['RTHLTH4'] > 0) & 
    (data['AGE4X'] >= 18) &   # Limiting to adults since BMI variable is for >17
    (data['ADBMI4'] > 0) & 
    (data['K6SUM4'] >= 0)
]

# Create Binary Target Variable
# 0 = Good Health (Excellent, Very Good, Good)
# 1 = Poor Health (Fair, Poor)
data['Health_Status_Binary'] = data['RTHLTH4'].apply(lambda x: 1 if x >= 4 else 0)

# Define Features (X) and Target (y)
X = data[['AGE4X', 'ADBMI4', 'K6SUM4']]
y = data['Health_Status_Binary']

print(f"Data after cleaning: {len(data)} records")
print("Class Distribution:\n", data['Health_Status_Binary'].value_counts())

# ==========================================
# 3. SCALING DATA (Crucial for KNN)
# ==========================================
# KNN calculates distance, so variables with large ranges (like Age) will dominate 
# variables with small ranges (like K6 Score) unless we scale them.

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# ==========================================
# 4. TRAIN/TEST SPLIT
# ==========================================
X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.3, random_state=42)

# ==========================================
# 5. TRAIN KNN MODEL
# ==========================================
# We choose k=5 as a starting point. You can tune this value.
k = 5
knn = KNeighborsClassifier(n_neighbors=k)
knn.fit(X_train, y_train)

# ==========================================
# 6. EVALUATION
# ==========================================
y_pred = knn.predict(X_test)

print(f"\n=== KNN Classification Report (k={k}) ===")
print(confusion_matrix(y_test, y_pred))
print(classification_report(y_test, y_pred))
print(f"Accuracy Score: {accuracy_score(y_test, y_pred):.2f}")

# ==========================================
# 7. OPTIONAL: FINDING OPTIMAL K
# ==========================================
error_rate = []

# Will take some time to run
for i in range(1, 40):
    knn_i = KNeighborsClassifier(n_neighbors=i)
    knn_i.fit(X_train, y_train)
    pred_i = knn_i.predict(X_test)
    error_rate.append(np.mean(pred_i != y_test))

plt.figure(figsize=(10,6))
plt.plot(range(1, 40), error_rate, color='blue', linestyle='dashed', marker='o',
         markerfacecolor='red', markersize=10)
plt.title('Error Rate vs. K Value')
plt.xlabel('K')
plt.ylabel('Error Rate')
plt.show()
